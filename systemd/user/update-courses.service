[Unit]
Description=Update lx-toolbox courses-list.txt from ROL catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/systemd/user/lx-toolbox.env
ExecStart=/bin/bash -c 'cd "$LX_TOOLBOX_DIR" && exec ./scripts/update-courses-cron.sh'
StandardOutput=journal
StandardError=journal
