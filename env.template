# LX Toolbox Environment Variables Template
# Copy this file to .env and fill in your credentials

# ROL Environment Credentials
RH_USERNAME=

# GitHub Credentials (for Factory)
GITHUB_USERNAME=

# China Environment Credentials
CHINA_USERNAME=

# ServiceNow API
SNOW_INSTANCE_URL=https://redhat.service-now.com
SNOW_API_USER=
SNOW_API_PASSWORD=

# LMS API (for user name lookups)
LMS_USERNAME=
LMS_CLIENT_ID=
LMS_CLIENT_SECRET=

# T1 Team Configuration
T1_FRONTEND_OPENSHIFT_ROUTE=

# Jira API (for future use)
JIRA_SERVER_URL=
JIRA_API_USER=
JIRA_API_TOKEN=

# LLM Provider — choose one of the two options below
# Models.corp portal : https://developer.models.corp.redhat.com/
# Getting started    : https://gitlab.cee.redhat.com/models-corp/user-documentation/-/blob/main/tutorials/01-your-first-chatbot.md

# Option A: Models.corp (Red Hat internal cloud — recommended, no local install needed)
LLM_PROVIDER=openai
OPENAI_MODEL=ibm-granite/granite-4.1-8b
OPENAI_BASE_URL=https://granite-4-1-8b--apicast-production.apps.int.stc.ai.prod.us-east-1.aws.paas.redhat.com/v1
USER_KEY=                        # your Models.corp user key
OPENAI_TIMEOUT_SECONDS=600
OPENAI_MAX_TOKENS=4096

# Option B: Local Ollama (requires Ollama installed and a model pulled)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=ministral-3:8b
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_TIMEOUT_SECONDS=600
# OLLAMA_MAX_NUM_CTX=32768