# LX Toolbox Environment Variables Template
# Copy this file to .env and fill in your credentials

# ROL Environment Credentials
RH_USERNAME=

# GitHub Credentials (for Factory)
GITHUB_USERNAME=

# China Environment Credentials
CHINA_USERNAME=

# ServiceNow API
SNOW_INSTANCE_URL=https://redhathub.service-now.com
SNOW_API_USER=
SNOW_API_PASSWORD=

# LMS API (for user name lookups)
LMS_USERNAME=
LMS_CLIENT_ID=
LMS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Team Configuration
# ---------------------------------------------------------------------------
# Each team reads {SECTION}_{KEY} env vars via ConfigManager.
# ASSIGNMENT_GROUP_ID  – ServiceNow assignment_group sys_id (comma-separated
#                        for teams with multiple groups, e.g. GLS Engagement NA)
# FRONTEND_OPENSHIFT_ROUTE – URL of the shift-scheduler frontend for the team
# ACKNOWLEDGMENT_TEMPLATE  – (optional) acknowledgment message sent to customers
#                            Supports placeholders: {customer_name}, {assignee_name}, {team_name}

# T1 Team
T1_FRONTEND_OPENSHIFT_ROUTE=
T1_ASSIGNMENT_GROUP_ID=

# T2 Team
T2_FRONTEND_OPENSHIFT_ROUTE=
T2_ASSIGNMENT_GROUP_ID=

# GLS RHLS Engagement
GLS_RHLS_ENGAGEMENT_APAC_ASSIGNMENT_GROUP_ID=
GLS_RHLS_ENGAGEMENT_EMEA_ASSIGNMENT_GROUP_ID=
GLS_RHLS_ENGAGEMENT_NA_ASSIGNMENT_GROUP_ID=

# Remote Exam - Readiness Support
REMOTE_EXAM_READINESS_SUPPORT_ASSIGNMENT_GROUP_ID=
REMOTE_EXAM_READINESS_SUPPORT_FRONTEND_OPENSHIFT_ROUTE=

# ---------------------------------------------------------------------------
# GLS CX Zones & Groups (JSON)
# ---------------------------------------------------------------------------
# For teams with per-group sub-teams (e.g. GLS CX APAC), set this JSON var.
# The frontend reads it at startup to seed zones/groups in state.json.
# The backend reads it to build per-group TeamConfig entries dynamically.
#
# Format:
#   SNOW_GROUPS_CONFIG={"zones":[{"id":"apac","name":"APAC"}],"groups":[{"id":"anz","name":"ANZ","zone_id":"apac","assignment_group_ids":["<sys_id>"]}]}
#
# Schedule-only group prefixes (no SNOW assignment group needed; used for subject-based routing):
#   audit-{zone_id}              — "Audit Request received" tickets
#   rhls-entitlement-{zone_id}  — "New RHLS Course Entitlement" tickets
#   tua-{zone_id}               — "mentioned you in Pending TUAs" tickets
# These groups must carry a real assignment_group_ids value to satisfy the config loader
# but are never used as a ticket queue — they only supply a shift schedule via the frontend.
#
# When set, the "Zones & Groups" management tab in the frontend is hidden
# and the zone/group CRUD routes return 403.
SNOW_GROUPS_CONFIG={"zones":[{"id":"latam","name":"LATAM"},{"id":"na","name":"NA"},{"id":"emea","name":"EMEA"},{"id":"apac","name":"APAC"}],"groups":[{"id":"gls-cx-br","name":"GLS Customer Experience - BR","zone_id":"latam","assignment_group_ids":["2e130c4013180704daa77b304244b025"]},{"id":"gls-cx-mx","name":"GLS Customer Experience - MX","zone_id":"latam","assignment_group_ids":["8d23048c13d40704daa77b304244b096"]},{"id":"gls-cx-latam","name":"GLS Customer Experience - LATAM","zone_id":"latam","assignment_group_ids":["d275b982138007c0daa77b304244b0b4"]},{"id":"gls-cx-int-latam-blr","name":"GLS CX Internal - LATAM Bangalore","zone_id":"latam","assignment_group_ids":["ec1336ac13d4cf04daa77b304244b013"]},{"id":"gls-cx-sac","name":"GLS Customer Experience - SAC","zone_id":"latam","assignment_group_ids":["7a23c88013180704daa77b304244b093"]},{"id":"gls-cx-namer","name":"GLS Customer Experience - NAMER","zone_id":"na","assignment_group_ids":["5cb5bcd14fe6a2004db6022f0310c72b"]},{"id":"gls-cx-int-namer","name":"GLS CX Internal - NAMER","zone_id":"na","assignment_group_ids":["7164f4764ffa26004db6022f0310c76e"]},{"id":"gls-cx-int-emea-blr","name":"GLS CX Internal - EMEA Bangalore","zone_id":"emea","assignment_group_ids":["bab5fcd14fe6a2004db6022f0310c752"]},{"id":"turkiye","name":"Türkiye GLS Support","zone_id":"emea","assignment_group_ids":["313289bd936f16907df0bfbd1dba1032"]},{"id":"igc","name":"IGC GLS Support","zone_id":"emea","assignment_group_ids":["e2f3c13d93ef16907df0bfbd1dba1066"]},{"id":"gls-cx-emea","name":"GLS Customer Experience - EMEA","zone_id":"emea","assignment_group_ids":["6885bcd14fe6a2004db6022f0310c729"]},{"id":"anz","name":"ANZ GLS Support","zone_id":"apac","assignment_group_ids":["c01937131b0d8d90c553fe28dc4bcb71"]},{"id":"asean","name":"ASEAN GLS Support","zone_id":"apac","assignment_group_ids":["f4057f931b898d90c553fe28dc4bcb9c"]},{"id":"gcg","name":"GCG GLS Support","zone_id":"apac","assignment_group_ids":["229c7b5f1b0d8d90c553fe28dc4bcb20"]},{"id":